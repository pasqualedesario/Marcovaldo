{
  "name": "marcovaldo",
  "private": true,
  "version": "0.4.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "smoke": "node scripts/smoke.mjs",
    "smoke:vf": "npx --yes vite-node@3.2.4 scripts/smoke-vf.mjs",
    "smoke:vf-full": "npx --yes vite-node@3.2.4 scripts/smoke-vf-full.mjs",
    "smoke:parity": "npx --yes vite-node@3.2.4 scripts/smoke-export-parity.mjs",
    "fonts": "node scripts/subset-fonts.mjs",
    "og": "npx --yes vite-node@3.2.4 scripts/gen-og.ts",
    "og:variants": "npx --yes vite-node@3.2.4 scripts/gen-og-variants.ts",
    "ci": "tsc -p tsconfig.json --noEmit && npm run smoke && npm run smoke:vf && npm run smoke:vf-full && npm run smoke:parity && vite build"
  },
  "dependencies": {
    "fontkit": "^2.0.4",
    "gsap": "^3.15.1",
    "opentype.js": "^2.0.0",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/fontkit": "^2.0.8",
    "@types/opentype.js": "^1.3.10",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  }
}
